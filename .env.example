OPENROUTER_API_KEY=
# Any OpenRouter model id (https://openrouter.ai/models), switch provider by switching the id
LLM_MODEL=anthropic/claude-sonnet-5.5

# Langfuse tracing, optional: one trace per run, observations per agent, LLM call and tool call
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_TRACING_ENVIRONMENT=development   # keeps test traces out of production dashboards
# LANGFUSE_RELEASE=0.1.0                     # app release shown on every trace

# Paths, defaults are inside the repository
# HYBRID_CHECKPOINT=models/hybrid_liar/best_model.pt
# LIAR_TRAIN_TSV=data/liar/train.tsv
# DB_PATH=data/app.db

# Limits
# RUN_TIMEOUT_S=120
# LLM_TIMEOUT_S=45
# LLM_MAX_RETRIES=2
# MAX_STEPS=8
